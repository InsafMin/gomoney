# General
ENVIRONMENT=development
LOG_LEVEL=debug

# Postgres
POSTGRES_DB=finance_tracker
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=
REDIS_PORT=6379

# JWT and security
JWT_SECRET=
JWT_EXPIRATION=15m
PASSWORD_MIN_LENGTH=8
PASSWORD_SALT=
TOKEN_REFRESH_TTL=168h

# Auth service
AUTH_SERVICE_PORT=50051
TRANSACTION_SERVICE_PORT=50052
ANALYTICS_SERVICE_PORT=50053
API_GATEWAY_PORT=8080

# Transaction service
DEFAULT_CURRENCY=RUB
ALLOWED_CURRENCIES=RUB,USD,EUR,KZT,GEL,TRY

# Analytics service
REPORT_CACHE_TTL=300s

# Kafka
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_TRANSACTIONS=transactions
KAFKA_CONSUMER_GROUP=analytics-group

# Kafka producer
KAFKA_PRODUCER_RETRY_MAX=3
KAFKA_PRODUCER_TIMEOUT=10s

# Kafka consumer
KAFKA_CONSUMER_SESSION_TIMEOUT=30s
KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest

# Timeouts
GRPC_TIMEOUT=30s
HTTP_TIMEOUT=60s

# Circuit breaker
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60s

# Retries
MAX_RETRIES=3
RETRY_DELAY=1s